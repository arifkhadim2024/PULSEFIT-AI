datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


model User {
  id                String            @id @default(uuid())
  email             String            @unique
  passwordHash      String
  name              String
  role              String            @default("USER") // USER, ADMIN
  avatar            String?
  fitnessGoal       String            @default("muscle_building") // muscle_building, strength, fat_loss, endurance, general_fitness, athletic
  experienceLevel   String            @default("beginner") // beginner, intermediate, advanced
  heightCm          Float?            @default(175)
  weightKg          Float?            @default(75)
  preferredDays     Int               @default(4)
  preferredDuration Int               @default(45) // minutes
  equipmentAccess   String            @default("full_gym") // full_gym, dumbbells_only, bodyweight_home, resistance_bands
  xp                Int               @default(0)
  level             Int               @default(1)
  streakDays        Int               @default(0)
  lastWorkoutDate   DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  workouts          Workout[]
  workoutLogs       WorkoutLog[]
  personalRecords   PersonalRecord[]
  bodyMeasurements  BodyMeasurement[]
  progressPhotos    ProgressPhoto[]
  achievements      Achievement[]
  aiConversations   AIConversation[]
}

model Exercise {
  id                     String          @id @default(uuid())
  name                   String          @unique
  slug                   String          @unique
  description            String
  primaryMuscle          String          // Chest, Back, Shoulders, Biceps, Triceps, Forearms, Abs, Glutes, Quadriceps, Hamstrings, Calves, Traps, Lower Back, Adductors, Abductors
  secondaryMuscles       String          // Comma-separated (e.g. "Triceps, Front Deltoids")
  bodyPart               String          // Chest, Back, Arms, Shoulders, Legs, Core, Full Body
  equipment              String          // Barbell, Dumbbell, Cable, Machine, Kettlebell, Resistance Band, Bodyweight, Smith Machine, Bench
  difficulty             String          // Beginner, Intermediate, Advanced
  movementPattern        String          // Horizontal Push, Horizontal Pull, Vertical Push, Vertical Pull, Squat, Hinge, Lunge, Carry, Isolation
  instructions           String          // Overview summary
  setupSteps             String          // JSON array or newline-separated
  executionSteps         String          // JSON array or newline-separated
  breathingInstructions  String
  tempo                  String          @default("3-0-1-0") // Eccentric-Pause-Concentric-Pause
  recommendedSets        String          @default("3-4")
  recommendedReps        String          @default("8-12")
  recommendedRestSec     Int             @default(90)
  commonMistakes         String          // JSON array of mistake & correction
  safetyTips             String
  beginnerAlternative    String?
  intermediateAlternative String?
  advancedAlternative    String?
  tags                   String          // Comma-separated keywords
  caloriesBurnPerHour    Int             @default(350)
  aliases                String?         // Comma-separated or JSON list of alternate names
  formCues               String?         // JSON array of key form cues
  videoUrl               String?         // Direct verified video URL
  thumbnailUrl           String?         // Direct thumbnail URL
  videoSource            String          @default("Kaggle: hasyimabdillah/workoutfitness-video")
  verificationStatus     String          @default("verified") // verified, needs_review, draft
  videoVerified          Boolean         @default(true)
  metadataVerified       Boolean         @default(true)
  sourceVerified         Boolean         @default(true)
  lastVerified           DateTime        @default(now())
  aiVideoUrl             String?         // AI-generated demonstration video URL
  aiVideoStatus          String?         @default("pending") // ready, generating, pending, failed
  aiVideoVerified        Boolean         @default(false)
  isCustom               Boolean         @default(false)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  media                  ExerciseMedia[]
  workoutExercises       WorkoutExercise[]
}

model ExerciseMedia {
  id          String   @id @default(uuid())
  exerciseId  String
  type        String   @default("IMAGE") // VIDEO, GIF, IMAGE
  url         String
  thumbnail   String?
  provider    String   @default("EXTERNAL") // UPLOAD, AI_GENERATED, EXTERNAL
  durationSec Int?
  isPrimary   Boolean  @default(true)
  createdAt   DateTime @default(now())

  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}

model Workout {
  id              String            @id @default(uuid())
  userId          String?
  name            String
  slug            String            @unique
  description     String
  category        String            @default("strength") // beginner, push_pull_legs, upper_lower, strength_5x5, home_minimal, fat_loss, athletic, custom
  difficulty      String            @default("Intermediate")
  durationMinutes Int               @default(45)
  isTemplate      Boolean           @default(false)
  isPublic        Boolean           @default(true)
  tags            String            @default("")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises       WorkoutExercise[]
  workoutLogs     WorkoutLog[]
}

model WorkoutExercise {
  id            String   @id @default(uuid())
  workoutId     String
  exerciseId    String
  orderIndex    Int      @default(0)
  targetSets    Int      @default(3)
  targetReps    String   @default("8-12")
  targetRestSec Int      @default(90)
  tempo         String?  @default("3-0-1-0")
  notes         String?

  workout       Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise      Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}

model WorkoutLog {
  id              String          @id @default(uuid())
  userId          String
  workoutId       String?
  workoutName     String
  startedAt       DateTime        @default(now())
  completedAt     DateTime        @default(now())
  durationMinutes Int             @default(30)
  totalVolumeKg   Float           @default(0)
  totalSets       Int             @default(0)
  totalReps       Int             @default(0)
  rating          Int?            @default(5)
  notes           String?
  xpEarned        Int             @default(100)
  createdAt       DateTime        @default(now())

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout         Workout?        @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  setLogs         WorkoutSetLog[]
}

model WorkoutSetLog {
  id           String     @id @default(uuid())
  workoutLogId String
  exerciseId   String
  exerciseName String
  setNumber    Int
  weightKg     Float      @default(0)
  reps         Int        @default(0)
  rpe          Float?     @default(8.0)
  isPR         Boolean    @default(false)
  completed    Boolean    @default(true)
  createdAt    DateTime   @default(now())

  workoutLog   WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
}

model PersonalRecord {
  id            String   @id @default(uuid())
  userId        String
  exerciseId    String
  exerciseName  String
  recordType    String   // HEAVIEST_WEIGHT, ESTIMATED_1RM, MAX_REPS, MAX_VOLUME
  value         Float
  repsAchieved  Int      @default(1)
  achievedAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BodyMeasurement {
  id          String   @id @default(uuid())
  userId      String
  recordedAt  DateTime @default(now())
  weightKg    Float?
  chestCm     Float?
  waistCm     Float?
  armsCm      Float?
  thighsCm    Float?
  shouldersCm Float?
  calvesCm    Float?
  notes       String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProgressPhoto {
  id         String   @id @default(uuid())
  userId     String
  photoUrl   String
  thumbnail  String?
  poseType   String   @default("FRONT") // FRONT, SIDE, BACK
  recordedAt DateTime @default(now())
  isPrivate  Boolean  @default(true)
  notes      String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String   @id @default(uuid())
  userId      String
  badgeKey    String   // FIRST_WORKOUT, STREAK_7, CENTURION_SETS, FIRST_PR, etc.
  title       String
  description String
  icon        String
  category    String   @default("general")
  unlockedAt  DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeKey])
}

model AIConversation {
  id        String      @id @default(uuid())
  userId    String
  title     String      @default("Fitness Consultation")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AIMessage[]
}

model AIMessage {
  id             String         @id @default(uuid())
  conversationId String
  role           String         // user, assistant, system
  content        String
  metadata       String?        // JSON string with recommended exercise slugs, etc.
  createdAt      DateTime       @default(now())

  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}
