# Database Configuration (Defaults to local SQLite for zero-setup local running, easily switch to PostgreSQL)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/fitpulse?schema=public"

# Auth Secrets
AUTH_SECRET="fitpulse-super-secret-jwt-key-change-in-production-32bytes"
JWT_EXPIRES_IN="7d"

# AI Provider Configuration (Optional - built-in AI Fitness Engine active by default)
# Supported providers: "local", "openai", "gemini", "anthropic"
AI_PROVIDER="local"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini" # or "gemini-1.5-pro", "claude-3-5-sonnet"

# Cloud Media Storage (Optional: S3 / Cloudinary / Supabase Storage)
STORAGE_PROVIDER="local"
STORAGE_URL=""
STORAGE_API_KEY=""

# App Config
NEXT_PUBLIC_APP_NAME="PulseFit AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
